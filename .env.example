# Optional local Factory configuration. Run from the repository root:
#   cp -n .env.example .env.factory.local
#   bun --no-env-file --env-file=.env.factory.local --watch apps/daemon/src/index.ts
# No Factory bootstrap secret or separate model key is required locally.
# Pi's existing environment, auth.json, models.json and settings are reused.
# See docs/local-setup.md for sign-in links and Execution node provisioning.

UZINA_MODE=local
HOST=127.0.0.1
PORT=8788

# Optional selection override. Without these, prefer Pi's configured default,
# then an available authenticated model. No provider request is made at startup.
# UZINA_MODEL_PROVIDER=openai
# UZINA_MODEL_ID=gpt-4o-mini

# Optional Pi profile override (default: ~/.pi/agent).
# PI_CODING_AGENT_DIR=/absolute/path/to/pi/agent

# Optional persistent storage (defaults remain outside the repository).
# UZINA_FACTORY_DATABASE_PATH=${HOME}/.local/share/uzina/factory.sqlite
# UZINA_MANAGED_WORK_DIRECTORY=${HOME}/.local/share/uzina/managed-work

# Owner and private-assistant credentials are provisioned into mode-0600 files
# beside the Factory database, not into this environment file.
# Never put a node credential or a secret in VITE_* browser variables.
