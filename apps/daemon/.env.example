# Execution node only. This is NOT a second Factory.
# Run commands from the repository root:
#   cp -n apps/daemon/.env.example apps/daemon/.env.node.local
#   chmod 600 apps/daemon/.env.node.local
# First provision this node and Workspace through the Owner API, then fill in
# its issued node credential and the absolute checkout directory below.
# Start:
#   bun --no-env-file --env-file=apps/daemon/.env.node.local --watch apps/daemon/src/index.ts
# Full provisioning instructions: docs/local-setup.md

UZINA_MODE=connected-executor
HOST=127.0.0.1
# Must differ from the Factory's port when running on the same machine.
PORT=8789

UZINA_CONTROLLER_URL=http://127.0.0.1:8788
# These IDs must match the Owner-provisioned records in this Factory.
UZINA_NODE_ID=node:local
# Required. Use the NODE credential returned by POST /v1/nodes.
# Never use the Owner/UI, bootstrap, assistant, or model-provider credential.
UZINA_NODE_CREDENTIAL=

UZINA_EXECUTION_DATABASE_PATH=${HOME}/.local/share/uzina/executor.sqlite
# Required. Replace the directory with an existing absolute checkout path.
# Keep this JSON array on one line; retain the surrounding single quotes.
UZINA_EXECUTION_WORKSPACES='[{"workspaceId":"workspace:repo","directory":"/absolute/path/to/your/checkout"}]'
