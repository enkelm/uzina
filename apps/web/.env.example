# Web development server only; this file contains NO credentials.
# Optional when the Factory uses its default address below.
# Run commands from the repository root:
#   cp -n apps/web/.env.example apps/web/.env.local
#   bun --no-env-file --env-file=apps/web/.env.local run dev:web
# Open the private owner sign-in link printed by the Factory, or an invitation.
# Full setup: docs/local-setup.md

# Server-side proxy target, not a browser-selected URL.
# Use a bare origin: no path, query, fragment, username, or password.
# HTTP is allowed only for loopback; non-loopback targets require HTTPS.
UZINA_WEB_API_ORIGIN=http://127.0.0.1:8788

# Never add bootstrap, human, node, assistant, or model-provider credentials.
# Never put secrets in VITE_* variables: Vite exposes those to browser code.
