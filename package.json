{
  "name": "uzina",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings apps packages",
    "check": "bun run lint && bun run format:check",
    "typecheck": "tsc --noEmit",
    "test": "bun test packages apps",
    "build": "bun run build:daemon && bun run build:cloudflare && bun run build:web",
    "build:web": "bun run --cwd apps/web build",
    "dev:web": "bun run --cwd apps/web dev",
    "build:daemon": "bun build apps/daemon/src/index.ts --target=bun --outdir=build/daemon",
    "build:cloudflare": "bun apps/cloudflare/scripts/build-worker.ts && wrangler deploy --dry-run --config apps/cloudflare/wrangler.toml --outdir build/cloudflare",
    "dev:daemon": "bun --watch apps/daemon/src/index.ts",
    "dev:cloudflare": "wrangler dev --local --ip 127.0.0.1 --config apps/cloudflare/wrangler.toml"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2",
    "wrangler": "^4.34.0"
  }
}
